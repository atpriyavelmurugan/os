    union semaphore snum;
    int sid, in, num, *buf, s;
    unsigned short a[3]; // FIXED: Properly allocated memory space for 3 elements
    in = 0;

    s = shmget(3306, sizeof(int) * size, IPC_CREAT | 0666);
    if (s == -1) {
        perror("shmget");
        exit(1);
    }

    buf = (int *)shmat(s, NULL, 0);
    if (buf == (void *)-1) {
        perror("shmat");
        exit(1);
    }

    sid = semget(0607, 3, IPC_CREAT | 0666);
    if (sid == -1) {
        perror("semget");
        exit(1);
    }

    // Initialize semaphores only if they aren't primed yet (Prevents overwriting if consumer started first)
    if (semctl(sid, empty, GETVAL) == 0 && semctl(sid, full, GETVAL) == 0) {
        a[mutex] = 1;
        a[full]  = 0;
        a[empty] = size;
        snum.array = a;
        semctl(sid, 0, SETALL, snum);
    }

    printf("Producer Ready (Enter -1 to exit)\n");

    while (1) {
        printf("Enter data: ");
        fflush(stdout);
        if (scanf("%d", &num) != 1) break;

        wait_sem(sid, empty);
        wait_sem(sid, mutex);

        buf[in % size] = num; // Circular mapping tracking

        if (num == -1) {
            printf("Sending termination signal to consumer...\n");
            signal_sem(sid, mutex);
            signal_sem(sid, full);
            break;
        }

        printf("Produced at index [%d]: %d\n", in % size, num);
        in++;

        signal_sem(sid, mutex);
        signal_sem(sid, full);
    }

    sleep(1); // Give consumer time to read the final exit code

    semctl(sid, 0, IPC_RMID);
    shmdt(buf);
    shmctl(s, IPC_RMID, NULL);
    printf("IPC cleared\n");
    return 0;
