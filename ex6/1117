class H2O {

    // Semaphores to track available slots for a single molecule
    private final Semaphore hSem = new Semaphore(2);
    private final Semaphore oSem = new Semaphore(1);
    
    // A barrier that resets after 3 threads (2H + 1O) arrive
    private final CyclicBarrier barrier = new CyclicBarrier(3);

    public H2O() {
        
    }

    public void hydrogen(Runnable releaseHydrogen) throws InterruptedException {
        // Acquire a hydrogen permit (only 2 allowed per molecule batch)
        hSem.acquire();
        
        try {
            // Wait for 3 threads (2 H and 1 O) to gather at the barrier
            barrier.await();
        } catch (Exception e) {
            // Handle barrier exceptions if threads are interrupted
        }
        
        // releaseHydrogen.run() outputs "H". Do not change or remove this line.
        releaseHydrogen.run();
        
        // If two hydrogen threads have run, we reset the permits for the next batch
        // We can safely release the permit back after the thread passes
        hSem.release();
    }

    public void oxygen(Runnable releaseOxygen) throws InterruptedException {
        // Acquire the single oxygen permit allowed per molecule batch
        oSem.acquire();
        
        try {
            // Wait for 3 threads (2 H and 1 O) to gather at the barrier
            barrier.await();
        } catch (Exception e) {
            // Handle barrier exceptions
        }

        // releaseOxygen.run() outputs "O". Do not change or remove this line.
        releaseOxygen.run();
        
        // Release the permit back for the next batch
        oSem.release();
    }
}
