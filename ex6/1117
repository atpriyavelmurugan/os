    if (s == -1) {
        perror("shmget");
        exit(1);
    }

    buf = (int *)shmat(s, NULL, 0);
    if (buf == (void *)-1) {
        perror("shmat");
        exit(1);
    }

    sid = semget(0607, 3, IPC_CREAT | 0666);
    if (sid == -1) {
        perror("semget");
        exit(1);
    }

    // Initialize semaphores safely if consumer starts before producer
    if (semctl(sid, empty, GETVAL) == 0 && semctl(sid, full, GETVAL) == 0) {
        a[mutex] = 1;
        a[full]  = 0;
        a[empty] = size;
        snum.array = a;
        semctl(sid, 0, SETALL, snum);
    }

    printf("Consumer Ready (Will exit when Producer sends -1)\n");

    while (1) {
        wait_sem(sid, full);
        wait_sem(sid, mutex);

        num = buf[out % size]; // Circular mapping tracking

        if (num == -1) {
            signal_sem(sid, mutex);
            signal_sem(sid, empty);
            break;
        }

        printf("Consumed from index [%d]: %d\n", out % size, num);
        fflush(stdout);
        out++;

        signal_sem(sid, mutex);
        signal_sem(sid, empty);
    }

    shmdt(buf);
    printf("Consumer Exited Gracefully.\n");
